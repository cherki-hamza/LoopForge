# LoopForge Environment Configuration

# PostgreSQL Database
POSTGRES_USER=loopforge
POSTGRES_PASSWORD=loopforge
POSTGRES_DB=loopforge
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://loopforge:loopforge@postgres:5432/loopforge

# Redis
REDIS_PORT=6380
REDIS_URL=redis://redis:6379/0

# Security & Authentication
JWT_SECRET=loopforge-super-secret-jwt-key-2026-production-ready
ADMIN_USERNAME=admin
ADMIN_PASSWORD=loopforge2026

# Storage & Job Processing Limits
STORAGE_DIR=/app/storage
MAX_FILE_SIZE_MB=500
MAX_CLIP_DURATION_SECONDS=120
MAX_CONCURRENT_JOBS=10
RETENTION_DAYS=14
JOB_TIMEOUT_SECONDS=7200

# CORS & Networking
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=http://localhost:8000/api
WEB_PORT=3001

